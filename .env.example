# Copy to .env.local and fill in. .env.local is gitignored.
# ALSO set every EXPO_PUBLIC_* var as an EAS env var — EAS cloud builds do NOT
# read .env.local, and a production build with missing vars ships a dead binary.

# Supabase — https://app.supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key

# Solana — cluster the app talks to. devnet while building, mainnet-beta to ship.
# Use a dedicated RPC (Helius/Triton/QuickNode) for mainnet; public RPC rate-limits.
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# SKR (Seeker token, SPL, 6 decimals). Mainnet mint is the default when the
# cluster is mainnet-beta: SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3
# On devnet there is no SKR — mint any 6-decimal test token
# (`spl-token create-token --decimals 6`), mint some to your wallet, and set
# it here. Leave blank on devnet to hide SKR pricing.
EXPO_PUBLIC_SKR_MINT=
# Treasury wallet that receives entry fees / pays out rewards (public key only).
EXPO_PUBLIC_TREASURY_ADDRESS=

# Sentry — https://sentry.io → Settings → Projects → (project) → Client Keys (DSN)
# The DSN is public-safe (it can only send events in, not read data out).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog — https://us.posthog.com → Settings → Project → Project API Key (starts phc_)
# Public-safe (write-only ingestion key).
EXPO_PUBLIC_POSTHOG_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY SECRETS — never put these here or in any EXPO_PUBLIC_* var.
# EXPO_PUBLIC_* values are inlined into the app bundle and are extractable.
#
# Supabase Edge Function secrets:  supabase secrets set NAME=value
#   SOLANA_RPC_URL            RPC the verify-purchase function reads from
#   TREASURY_ADDRESS          same public key as EXPO_PUBLIC_TREASURY_ADDRESS
#   SKR_MINT                  same mint as EXPO_PUBLIC_SKR_MINT
# EAS build-time secrets:  eas secret:create --scope project --name NAME --value ...
#   SENTRY_AUTH_TOKEN         sntrys_... — used only to upload source maps at build
# dApp Store publishing (local only, gitignored):
#   ./dapp-store/publisher-keypair.json   Solana keypair that owns the publisher NFT
#   ./dapp-store/release.keystore         Android release signing key (NOT your Play key)
# ─────────────────────────────────────────────────────────────────────────────
